# ============================================================
# إعدادات مفاتيح الـ API والاتصال (LinkedIn Job Agent)
# ============================================================

# 1. مفتاح Google Gemini API
# يمكنك الحصول عليه مجاناً فوراً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. إعدادات واتساب عبر CallMeBot (مجاني تماماً ولا يحتاج بطاقة أو اشتراك)
# خطوات تفعيله خلال 30 ثانية:
# - أضف الرقم الآتي إلى جهات اتصالك على واتساب: +34 644 44 24 53
# - أرسل له رسالة نصية بالإنجليزية: "I allow callmebot to send me messages"
# - سيرد عليك برمز الـ API Key الخاص بك فوراً.
CALLMEBOT_PHONE=+966500000000
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# (اختياري) بديل Twilio لواتساب (إذا كنت تفضل استخدام Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+966500000000
